# ── ROUGE ─────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local y completá tus credenciales de Supabase.
# Si NO hay credenciales, la app arranca en "Modo Demo" (estado local con
# persistencia en localStorage y datos precargados), sin backend.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app. La usa el servidor para armar la vuelta del OAuth de Instagram
# (los links y QRs del navegador usan el dominio desde el que se abre la app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Login social (solo con Supabase; en Modo Demo los botones se simulan) ──
# Google: Supabase → Authentication → Providers → Google (Client ID/Secret de Google Cloud).
# Redirect URI autorizada en Google Cloud: https://<proyecto>.supabase.co/auth/v1/callback
NEXT_PUBLIC_AUTH_GOOGLE=0

# Instagram (Instagram API with Instagram Login · cuentas profesionales: Creador o Empresa).
# Meta for Developers → app → producto Instagram → "API setup with Instagram login".
# Redirect URI válida: <NEXT_PUBLIC_APP_URL>/api/instagram/callback
# Deauthorize y Data Deletion callback: <NEXT_PUBLIC_APP_URL>/api/instagram/data-deletion
NEXT_PUBLIC_AUTH_INSTAGRAM=0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_): tokens de Instagram, sesión y la API v1 para ticketeras
# (/api/v1, ver docs/api). La API también usa NEXT_PUBLIC_APP_URL para armar join_url y qr_url.
SUPABASE_SERVICE_ROLE_KEY=

# Sitio de demostración (Modo Demo). En el sitio con datos reales, /demo manda ahí.
NEXT_PUBLIC_DEMO_URL=
